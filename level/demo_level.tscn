offset_right = 520
offset_bottom = -330
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 22
text = "A/D — движение, Shift — шаг, Space — прыжок, S — присед, C — кувырок\nПКМ — прицел (торс/голова/руки за курсором), ЛКМ — выстрел, R — перезарядка\nF — удар кулаком, K — рагдолл, T — IK ног, 1-5 — экипировка, 6 — скин, F5 — рестарт"

[node name="Hint2" type="Label" parent="Hints"]
offset_left = 520
offset_top = -330
offset_right = 1420
offset_bottom = -240
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 22
text = "Лестница: коллизия — рампа, а IK ставит стопы на ступени.\nТаз опускается к нижней стопе, стопа поворачивается по нормали (T — выкл/вкл)."

[node name="Hint3" type="Label" parent="Hints"]
offset_left = 1210
offset_top = -250
offset_right = 2110
offset_bottom = -160
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 22
text = "Склон 30°: стопы ложатся вдоль поверхности."

[node name="Hint4" type="Label" parent="Hints"]
offset_left = 1520
offset_top = -420
offset_right = 2420
offset_bottom = -330
theme_override_colors/font_color = Color(0.85, 0.88, 0.92, 1)
theme_override_font_sizes/font_size = 22
text = "Уступ: подпрыгни к стене — персонаж зацепится руками (IK кистей).\nSpace — подтянуться, S — отпустить."

[node name="Hint5" type="Label" parent="Hints"]
offset_left = 2140
